{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "frontend.html",
          "login.html",
          "setup-guide.html",
          "account.html",
          "anvandarvillkor.html",
          "integritetspolicy.html",
          "cv_template.html"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
