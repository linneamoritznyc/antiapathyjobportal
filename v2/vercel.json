{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "frontend.html",
          "login.html",
          "setup-guide.html",
          "account.html",
          "anvandarvillkor.html",
          "integritetspolicy.html",
          "cv_template.html",
          "lan-data.js",
          "linkedin-parser.js",
          "manifest.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
